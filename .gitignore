# dependencies
/node_modules
/xtechart/node_modules
/xtechart/.next
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# uploads & sensitive server data
/public/uploads/
/data/private/
/deploy/auth.env.seed

# visual prototype kept beside the Next.js app
/design-demo/node_modules


# handover: dependencies, builds, env
node_modules/
.next/
.env*
!.env.example

# sessions & secrets generated at runtime
sessions/
data/store/.session-secret
_secrets/

# customer data (the app recreates these as empty lists when missing)
data/store/users.json
data/store/sessions.json
data/store/orders.json
data/store/chats.json
data/store/contact-messages.json
data/store/newsletter.json
data/store/fabric-sample-requests.json

