# Lokalny adres sklepu. PayU, SMTP i SMS zostaw puste, dopóki ich nie podłączamy.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
SITE_URL=http://127.0.0.1:3000

# PayU — sandbox do testów. Klucze produkcyjne trzymaj poza repozytorium.
PAYU_ENV=sandbox
PAYU_POS_ID=
PAYU_CLIENT_ID=
PAYU_CLIENT_SECRET=
PAYU_SECOND_KEY=

# E-mail (SMTP). Da się też wpisać w Admin / Ustawienia.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SMS (SMSAPI.pl) — opcjonalnie
SMSAPI_TOKEN=
SMS_NOTIFY_TO=
# SMS_FROM=Eco

# Opcjonalny klucz sesji. Bez niego aplikacja generuje data/store/.session-secret.
# SOFELIO_SESSION_SECRET=
